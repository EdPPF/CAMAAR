<!DOCTYPE html>
<html>
<head>
  <title>Criação de Questões</title>
  </head>
<body>
  <main>
    <%if current_user %>
    <h1>Escolha o texto da questao.</h1>
        <%= form_with url: nova_questao_template_path, method: :post,  model: @questao do |form| %>
            <%= form.hidden_field :template_id, value: @questao.template_id %>
            <%= form.label :texto, 'Texto', :class => 'form-control' %>
            <%= form.text_field :texto, :class => 'form-control' %>
            <%= form.submit "Salvar Questao" %>
        <% end %>
        <p><%= link_to 'Voltar para pagina anterior', root_path %> </p>
    <% else %>
      <p>you are not signed in.</p>
      <%= link_to "Sign Up!", new_user_registration_path%>
      <br/>
      <%= link_to "Login", new_user_session_path%>
    <%end %>
  </main>
</body>
</html>